{
  "name": "jeremy-sagnier-site",
  "version": "1.0.0",
  "description": "Site personnel Jérémy Sagnier — HTML statique + script de publication drafts/*.md → articles/*.html",
  "private": true,
  "type": "module",
  "scripts": {
    "publish": "node scripts/publish.js",
    "publish:all": "node scripts/publish.js --all",
    "seo:improve": "node scripts/seo-improve.js",
    "lexique:build": "node scripts/build-lexique.js",
    "lexique:check": "node scripts/build-lexique.js --check",
    "podcast:rss": "node scripts/build-podcast-rss.js",
    "podcast:covers": "node scripts/build-podcast-covers.js",
    "podcast:page": "node scripts/build-podcast-page.js",
    "podcast:build": "npm run podcast:covers && npm run podcast:rss && npm run podcast:page",
    "podcast:upload": "node scripts/podcast-upload.js",
    "indexnow": "node scripts/indexnow-ping.js",
    "news:build": "node scripts/build-news-summary.js",
    "test": "node --test scripts/test-helpers.js tests/news.test.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1036.0",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.0",
    "puppeteer": "^24.42.0",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@supabase/supabase-js": "^2.105.3",
    "@vercel/blob": "^2.3.3",
    "fast-xml-parser": "^5.8.0",
    "stripe": "^22.1.1",
    "ws": "^8.20.0"
  }
}
